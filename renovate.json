{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>cffnpwr/renovate-config"],
  "ignorePaths": [
    // NOTE: `mise lock`で生成されるためignore
    ".mise/locks/**"
  ],
  "customManagers": [
    {
      // NOTE: ApplicationSetのパラメーターにあるchartはArgo CDのマニフェストではないため、argocd managerの対象外
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["/^kubernetes/apps/[^/]+/app\\.yaml$/"],
      "matchStrings": [
        "chart[$contains(repoURL, \"://\")].{ \"depName\": name, \"currentValue\": version, \"registryUrl\": repoURL }"
      ],
      "datasourceTemplate": "helm"
    },
    {
      // NOTE: スキームのないrepoURLはArgo CDがOCIリポジトリとして扱うchart
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["/^kubernetes/apps/[^/]+/app\\.yaml$/"],
      "matchStrings": [
        "chart[$not($contains(repoURL, \"://\"))].{ \"depName\": repoURL & \"/\" & name, \"currentValue\": version }"
      ],
      "datasourceTemplate": "docker"
    },
    {
      // NOTE: images/vaultwardenがソースからビルドするvaultwardenのタグとコミット
      "customType": "regex",
      "managerFilePatterns": ["/^images/vaultwarden/Dockerfile$/"],
      "matchStrings": [
        "ARG VAULTWARDEN_VERSION=(?<currentValue>\\S+)\\s+ARG VAULTWARDEN_COMMIT=(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "dani-garcia/vaultwarden"
    },
    {
      // NOTE: ノードにインストールするTalosのバージョン
      //       talos_config_versionはクラスタ作成時のバージョンに固定するため対象外
      "customType": "regex",
      "managerFilePatterns": ["/^terraform/versions\\.tf$/"],
      "matchStrings": ["\\stalos_version\\s*=\\s*\"(?<currentValue>v[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos"
    },
    {
      // NOTE: miseのタスクがgo runで実行するcffnpwr/actionsのmainブランチのコミット
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["github\\.com/cffnpwr/actions/[^@\\s]+@(?<currentDigest>[0-9a-f]{40})"],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/cffnpwr/actions",
      "depNameTemplate": "cffnpwr/actions"
    }
  ],
  "packageRules": [
    {
      // NOTE: Keaはマイナーバージョンが奇数のものを開発版として公開するため、偶数の安定版に限定
      "matchPackageNames": ["jonasal/kea-dhcp4"],
      "allowedVersions": "/^[0-9]+\\.[0-9]*[02468]\\.[0-9]+-alpine$/"
    },
    {
      // NOTE: ソースからビルドするバイナリと、web-vault等を取得する公式イメージのバージョンを揃える
      "matchFileNames": ["images/vaultwarden/Dockerfile"],
      "matchPackageNames": [
        "dani-garcia/vaultwarden",
        "/(^|/)vaultwarden/server$/"
      ],
      "groupName": "vaultwarden"
    },
    {
      // NOTE: netbirdのサーバーコンポーネントとCIで使うCLIのバージョンを揃える
      //       GitHub ReleasesとDockerイメージの公開時刻の差で一部の更新だけのPRが作られないよう、全コンポーネントが揃うまで待機
      "matchDepNames": [
        "github:netbirdio/netbird",
        "netbirdio/signal",
        "netbirdio/management",
        "netbirdio/relay"
      ],
      "groupName": "netbird",
      "minimumGroupSize": 4
    },
    {
      // NOTE: talosctlとTalos APIクライアントのGoモジュールをノードのTalosのバージョンに揃える
      "matchDepNames": [
        "talosctl",
        "siderolabs/talos",
        "github.com/siderolabs/talos/pkg/machinery"
      ],
      "groupName": "talos"
    },
    {
      // NOTE: miseで管理するCLIのバージョンを、chartでデプロイするKyvernoのバージョンに揃える
      "matchDepNames": ["kyverno"],
      "groupName": "kyverno"
    },
    {
      // NOTE: kubesealのCLI・イメージ・Goモジュールのバージョンをchartでデプロイするcontrollerのバージョンに揃える
      "matchDepNames": [
        "kubeseal",
        "docker.io/bitnami/sealed-secrets-kubeseal",
        "github.com/bitnami/sealed-secrets",
        "sealed-secrets"
      ],
      "groupName": "sealed-secrets"
    },
    {
      // NOTE: operatorのchartとCephClusterのchartはRookの同じバージョンとして公開される
      "matchDepNames": ["rook-ceph", "rook-ceph-cluster"],
      "groupName": "rook-ceph"
    },
    {
      // NOTE: miseで管理するkubectlとイメージに含めるkubectlのバージョンを揃える
      "matchDepNames": ["kubectl", "registry.k8s.io/kubectl"],
      "groupName": "kubectl"
    }
  ],
  "kubernetes": {
    // NOTE: kubernetes managerには既定のファイルパターンがない
    "managerFilePatterns": ["/^kubernetes/apps/.+\\.yaml$/"]
  }
}
