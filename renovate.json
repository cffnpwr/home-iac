{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>cffnpwr/renovate-config"],
  "ignorePaths": [
    // NOTE: `mise lock`で生成されるためignore
    ".mise/locks/**"
  ],
  "customManagers": [
    {
      // NOTE: ApplicationSetのパラメーターのchartはArgo CDのマニフェストではないため、argocd managerの対象外
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["/^kubernetes/apps/[^/]+/app\\.yaml$/"],
      "matchStrings": [
        "chart.{ \"depName\": name, \"currentValue\": version, \"registryUrl\": repoURL }"
      ],
      "datasourceTemplate": "helm"
    },
    {
      // NOTE: images/vaultwardenがソースからビルドする、vaultwardenのタグとそのコミット
      "customType": "regex",
      "managerFilePatterns": ["/^images/vaultwarden/Dockerfile$/"],
      "matchStrings": [
        "ARG VAULTWARDEN_VERSION=(?<currentValue>\\S+)\\s+ARG VAULTWARDEN_COMMIT=(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "dani-garcia/vaultwarden"
    }
  ],
  "packageRules": [
    {
      // NOTE: Keaはマイナーバージョンが奇数のバージョンを開発版として公開するため、偶数の安定版に限定
      "matchPackageNames": ["jonasal/kea-dhcp4"],
      "allowedVersions": "/^[0-9]+\\.[0-9]*[02468]\\.[0-9]+-alpine$/"
    },
    {
      // NOTE: ソースからビルドするバイナリと、web-vault等を使う公式のイメージのバージョンを揃える
      "matchFileNames": ["images/vaultwarden/Dockerfile"],
      "matchPackageNames": ["dani-garcia/vaultwarden", "/(^|/)vaultwarden/server$/"],
      "groupName": "vaultwarden"
    }
  ],
  "kubernetes": {
    // NOTE: kubernetes managerには既定のファイルパターンが無い
    "managerFilePatterns": ["/^kubernetes/apps/.+\\.yaml$/"]
  }
}
