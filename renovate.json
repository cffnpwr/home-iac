{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>cffnpwr/renovate-config"],
  "ignorePaths": [
    // NOTE: `mise lock`で生成されるためignore
    ".mise/locks/**"
  ],
  "argocd": {
    // NOTE: argocd managerには既定のファイルパターンが無い
    "managerFilePatterns": ["/^kubernetes/apps/.+\\.yaml$/"]
  },
  "kubernetes": {
    // NOTE: kubernetes managerには既定のファイルパターンが無い
    "managerFilePatterns": ["/^kubernetes/platform/.+\\.yaml$/"]
  }
}
