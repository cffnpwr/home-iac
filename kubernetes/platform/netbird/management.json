{
  "Stuns": [
    {
      "Proto": "udp",
      "URI": "stun:nb.cffnpwr.dev:3478"
    }
  ],
  "Relay": {
    "Addresses": ["rels://nb.cffnpwr.dev:443"],
    "CredentialsTTL": "24h",
    "Secret": "{{ .NETBIRD_RELAY_AUTH_SECRET }}"
  },
  "Signal": {
    "Proto": "https",
    "URI": "nb.cffnpwr.dev:443"
  },
  "ReverseProxy": {
    "TrustedPeers": ["10.244.0.0/16"]
  },
  "Datadir": "/var/lib/netbird",
  "DataStoreEncryptionKey": "{{ .NETBIRD_DATASTORE_ENCRYPTION_KEY }}",
  "StoreConfig": {
    "Engine": "sqlite"
  },
  "EmbeddedIdP": {
    "Enabled": true,
    "Issuer": "https://netbird.cffnpwr.dev/oauth2",
    "SignKeyRefreshEnabled": true,
    "LocalAuthDisabled": true,
    "DashboardRedirectURIs": [
      "https://netbird.cffnpwr.dev/nb-auth",
      "https://netbird.cffnpwr.dev/nb-silent-auth"
    ],
    "CLIRedirectURIs": ["http://localhost:53000/"],
    "Owner": {
      "Email": "placeholder-owner@netbird.invalid",
      "Hash": "{{ .NETBIRD_PLACEHOLDER_OWNER_PASSWORD_HASH }}"
    },
    "StaticConnectors": [
      {
        "type": "oidc",
        "id": "cloudflare-access",
        "name": "Cloudflare Access",
        "config": {
          "issuer": "{{ .NETBIRD_ACCESS_ISSUER }}",
          "clientID": "{{ .NETBIRD_ACCESS_CLIENT_ID }}",
          "clientSecret": "{{ .NETBIRD_ACCESS_CLIENT_SECRET }}",
          "redirectURI": "https://netbird.cffnpwr.dev/oauth2/callback"
        }
      }
    ]
  }
}
